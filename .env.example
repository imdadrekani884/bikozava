# =============================================================================
# BIKOZAVA WEDDING INVITATION PLATFORM — ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================
# Copy this file to .env and replace placeholder values before deploying:
#   copy .env.example .env
# =============================================================================

# Application Environment: development | testing | production
FLASK_ENV=production
FLASK_DEBUG=0
APP_NAME=Bikozava
PUBLIC_BASE_URL=https://bikozava.com

# Cryptographic Secret Key (REQUIRED in production - minimum 32 random bytes)
SECRET_KEY=replace_with_a_64_char_hex_secret_generated_via_secrets_token_hex

# Database Connection (Supabase PostgreSQL URI or local SQLite fallback)
# Supabase / PostgreSQL example:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
# Local development fallback:
DATABASE_URL=sqlite:///instance/bikozava.db

# Optional Supabase Storage / API Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_never_expose_to_frontend
SUPABASE_STORAGE_BUCKET=wedding-media

# Initial Bootstrap Admin Account (Synced on startup)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@bikozava.com
ADMIN_INITIAL_PASSWORD=ChangeThisStrongPassword!2026

# Security & Session Hardening (Set SESSION_COOKIE_SECURE=1 when behind HTTPS)
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_SECONDS=28800

# Login Rate Limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Upload Limits
MAX_CONTENT_LENGTH_MB=25
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,ogg,m4a
ALLOWED_VIDEO_EXTENSIONS=mp4,webm
