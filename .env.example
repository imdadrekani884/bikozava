# =============================================================================
# BIKOZAVA WEDDING INVITATION PLATFORM — ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================
# Copy this file to .env and replace placeholder values before deploying:
#   Windows CMD:        copy .env.example .env
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux / macOS:      cp .env.example .env
#
# SECURITY WARNING:
#   - NEVER commit your real .env file to GitHub (https://github.com/imdadrekani884/bikozava).
#   - NEVER expose SUPABASE_SERVICE_ROLE_KEY or DATABASE_URL to browser/frontend code.
# =============================================================================

# Application Environment: development | testing | production
FLASK_ENV=production
FLASK_DEBUG=0
APP_NAME=Bikozava
PUBLIC_BASE_URL=https://bikozava.com

# Cryptographic Secret Key (REQUIRED in production - generate via: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace_with_a_64_char_hex_secret_generated_via_secrets_token_hex

# =============================================================================
# SUPABASE POSTGRESQL & STORAGE CONFIGURATION (Project: rgshkpvhttjdbkycuesv)
# =============================================================================
SUPABASE_PROJECT_REF=rgshkpvhttjdbkycuesv
SUPABASE_URL=https://rgshkpvhttjdbkycuesv.supabase.co
# Server-side only! Never expose in HTML/JS:
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key_server_only
SUPABASE_ANON_KEY=replace_with_supabase_anon_public_key_optional
SUPABASE_STORAGE_BUCKET=wedding-media

# Database Connection (Supabase PostgreSQL URI in production, or local SQLite in dev)
# Production Supabase Transaction Pooler (IPv4 compatible for Render/VPS):
# DATABASE_URL=postgresql://postgres.rgshkpvhttjdbkycuesv:[YOUR-DB-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
# Local development fallback:
DATABASE_URL=sqlite:///instance/bikozava.db

# =============================================================================
# INITIAL BOOTSTRAP ADMIN ACCOUNT
# =============================================================================
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@bikozava.com
ADMIN_INITIAL_PASSWORD=ChangeThisStrongPassword!2026
# Set FORCE_RESET_ADMIN_PASSWORD=1 only if you locked yourself out and need .env to overwrite DB password on restart:
FORCE_RESET_ADMIN_PASSWORD=0

# =============================================================================
# ADMIN NETWORK RESTRICTION (Optional — Tailscale VPN / Static IP Allowlist)
# =============================================================================
# Leave empty ("") if accessing from changing mobile/cellular IPs without a VPN.
# To restrict /admin to Tailscale VPN only, set: ADMIN_ALLOWED_IPS=100.64.0.0/10,127.0.0.1,::1
# Supports comma-separated single IPs and CIDR subnets.
ADMIN_ALLOWED_IPS=

# Trust X-Forwarded-For header only when deployed behind Render/Cloudflare/Nginx reverse proxy (1 = yes, 0 = no)
TRUST_PROXY_HEADERS=1

# =============================================================================
# SESSION, COOKIE & CORS HARDENING
# =============================================================================
# Set SESSION_COOKIE_SECURE=1 in production (HTTPS), 0 for localhost HTTP testing
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_SECONDS=28800
ADMIN_SESSION_IDLE_TIMEOUT_SECONDS=1800
FORCE_HTTPS=0

# Strict CORS Origin Allowlist (comma-separated, never '*')
CORS_ALLOWED_ORIGINS=https://bikozava.com,https://www.bikozava.com,http://localhost:8000,http://127.0.0.1:8000

# =============================================================================
# RATE LIMITING & ANTI-ABUSE
# =============================================================================
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
RSVP_RATE_LIMIT_MAX_ATTEMPTS=5
RSVP_RATE_LIMIT_WINDOW_SECONDS=3600

# =============================================================================
# UPLOAD SECURITY LIMITS
# =============================================================================
MAX_CONTENT_LENGTH_MB=25
MAX_IMAGE_UPLOAD_MB=10
MAX_AUDIO_UPLOAD_MB=15
MAX_VIDEO_UPLOAD_MB=25
MAX_IMAGE_DIMENSION_PX=6000
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,ogg,m4a
ALLOWED_VIDEO_EXTENSIONS=mp4,webm
